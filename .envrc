#!/usr/bin/env bash

GITBASE="$(git rev-parse --show-toplevel)"

# shellcheck disable=SC2034
ENVRC_DIR="${GITBASE}/.envrc.d"

# shellcheck disable=SC2155
if false; then
   export PYTHON_VERSION="$(cat "${GITBASE}/.python-version")"
   layout python_uv "${PYTHON_VERSION}"
else
   layout uvd
fi

source_env_if_exists ".config/bash-completions.d/*.sh"
